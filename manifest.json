{
  "manifest_version": 3,
  "name": "PokeIdle - Assistente de preço",
  "version": "1.0.0",
  "description": "No formulário de anunciar do Mercado do PokeIdle, mostra o preço de empate, o lucro e sugere o preço para a margem que você quer.",
  "homepage_url": "https://github.com/Rodrigo019/pokeidle-assistente-preco",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://pokeidle.io/*", "https://www.pokeidle.io/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
